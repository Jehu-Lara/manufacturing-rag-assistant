# Phase 3 (LLM generation)
# Copy to .env (gitignored) and fill in when Phase 3 starts.

GROQ_API_KEY=
OPENAI_API_KEY=

# groq | openai — primary provider; the other is always tried as a fallback on failure
LLM_PROVIDER=groq

# Raw cosine-similarity cutoff for the refusal gate — computed from real eval-set data,
# see eval/reports/threshold_analysis_v1.0.0.md and SPEC.md's Phase 3 status addendum
# (2026-08-25) for why this is 0.5999, not the script's literal 0.5599 output.
REFUSAL_COSINE_THRESHOLD=0.5999

# Phase 3 refusal gate policy (ADR-009).
#   binary          — single 0.5999 cutoff; current default behaviour.
#   grounded_review — adds a middle band [REFUSAL_REVIEW_FLOOR, 0.5999) that makes
#                     ONE logical verified LLM call instead of refusing. "One logical
#                     call" is the gate contract, not a network guarantee: the adapter
#                     may still do physical provider retries, JSON repair, or a
#                     primary->fallback provider switch underneath.
REFUSAL_POLICY=binary

# Lower edge of the grounded_review band. Must be finite and in [0, 1], and strictly
# below REFUSAL_COSINE_THRESHOLD when REFUSAL_POLICY=grounded_review. Pre-registered
# at 0.5500 in ADR-009 — do not retune toward individual eval cases.
REFUSAL_REVIEW_FLOOR=0.5500

LOG_LEVEL=INFO

# Optional: if set, /query requires this exact value in the X-API-Key header
API_KEY=

# Optional: comma-separated browser origins allowed to call the API (empty = CORS disabled).
# When set, preflight allows GET/POST with Content-Type, X-API-Key, X-Client-Session.
CORS_ALLOW_ORIGINS=
